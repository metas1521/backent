# Replit Configuration for BMRX Backend
run = "npm run start-with-keepalive"
hidden = ["node_modules", ".git", "*.log"]

[env]
NODE_ENV = "development"
PORT = "5000"
RATE_LIMIT_MAX = "120"

[deployment]
run = ["npm", "run", "start-with-keepalive"]
deploymentTarget = "cloudrun"

[packager]
language = "nodejs"
packageManager = "npm"
